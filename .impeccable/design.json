  "narrative": {
    "northStar": "Calm football comparisons",
    "overview": "Dranx presents a friends' competition through compact headings, readable comparison rows, and warm surfaces. Purple carries identity; lime marks primary actions and selected highlights. Local club badges connect the interface to the competition.\n\nThe podium adds restrained playfulness through outlined animal icons. Names, scores, and occupied ranks remain the authoritative information. This record describes the approved implementation; source components and global styles govern behavior when an illustrative snippet omits application logic.",
    "keyCharacteristics": [
      "Warm paper with purple text and restrained lime accents.",
      "Compact headers and dense, readable comparison rows.",
      "Equal visual treatment for every participant at the same podium rank.",
      "Responsive layouts with explicit labels and visible action states."
    ],
    "rules": [
      {
        "name": "The semantic pair Rule",
        "body": "Use each status foreground with its matching surface, and retain a text label or numerical cue.",
        "section": "colors"
      },
      {
        "name": "The comparison hierarchy Rule",
        "body": "Keep club or participant names prominent, supporting facts quieter, and scores aligned. Let long names wrap instead of concealing them.",
        "section": "typography"
      },
      {
        "name": "The resting surface Rule",
        "body": "Use borders and tone for ordinary content; reserve raised layers for controls or transient content that already uses elevation.",
        "section": "elevation & depth"
      },
      {
        "name": "The equal place Rule",
        "body": "Give every participant at the same rank the same visual status, without truncating the group.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use theme-aware surface and text pairs.",
      "**Do** keep names, ranks, status labels, and numerical differences visible independently of color or decoration.",
      "**Do** include every tied podium participant with equal treatment.",
      "**Do** preserve full-page review, draft retention, visible focus, and immutable action feedback.",
      "**Do** reuse the original local club badges and existing decorative animal system."
    ],
    "donts": [
      "**Don't** turn a compact heading into a decorative eyebrow stack.",
      "**Don't** hide comparison facts or middle review rows to make a narrow screen look shorter.",
      "**Don't** replace working controls with static visual imitations or remove publication safeguards.",
      "**Don't** turn illustrative participant data, icon choices, or prototype content into persisted product data."
    ]
  }
}
