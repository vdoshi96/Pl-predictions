{
  "name": "pl-predictions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "dotenv -e .env.local -- env RUN_DB_INTEGRATION=1 node scripts/run-with-test-database.mjs vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:prepare && npm run test:e2e:pre-kickoff && npm run test:e2e:post-kickoff",
    "test:e2e:prepare": "npm run db:test:migrate && npm run db:test:seed && npm run db:test:seed:win-streak",
    "test:e2e:pre-kickoff": "dotenv -e .env.local -- env PL_PREDICTIONS_TEST_NOW_ISO=2026-08-08T12:00:00.000Z node scripts/run-with-test-database.mjs playwright test --grep-invert post-kickoff",
    "test:e2e:post-kickoff": "dotenv -e .env.local -- env PL_PREDICTIONS_TEST_NOW_ISO=2026-08-21T19:10:00.000Z node scripts/run-with-test-database.mjs playwright test tests/e2e/post-kickoff-leaderboard.spec.ts",
    "test:production-smoke": "dotenv -e .env.local -- env ALLOW_PRODUCTION_READ_ONLY_SMOKE=1 playwright test tests/e2e/production-smoke.spec.ts",
    "test:production-write-smoke": "dotenv -e .env.local -- playwright test tests/e2e/production-write-smoke.spec.ts --project=mobile-chromium --reporter=list",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:seed:win-streak": "dotenv -e .env.local -- tsx scripts/seed-win-streak-fixtures.ts",
    "db:test:migrate": "dotenv -e .env.local -- node scripts/run-with-test-database.mjs drizzle-kit migrate",
    "db:test:seed": "dotenv -e .env.local -- node scripts/run-with-test-database.mjs tsx scripts/seed.ts",
    "db:test:seed:win-streak": "dotenv -e .env.local -- node scripts/run-with-test-database.mjs tsx scripts/seed-win-streak-fixtures.ts",
    "players:generate": "tsx scripts/normalize-player-catalogue.ts",
    "players:check": "tsx scripts/normalize-player-catalogue.ts --check",
    "win-streak:fixtures:apply": "tsx scripts/refresh-win-streak-fixtures.ts --apply",
    "win-streak:fixtures:check": "tsx scripts/refresh-win-streak-fixtures.ts --check",
    "standings:import": "dotenv -e .env.local -- tsx scripts/import-standings.ts",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "docs:generate": "node scripts/generate-docs-html.mjs",
    "docs:check": "node scripts/generate-docs-html.mjs --check",
    "check": "npm run docs:check && npm run players:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build:verify && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-dialog": "1.1.23",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "marked": "18.0.9",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "tsx": "4.23.11",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
